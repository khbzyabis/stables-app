# Local development image: the Flutter SDK and all build dependencies live in
# here, so nothing but Docker is needed on your machine. Serves the web app on
# port 3000 with hot restart.
#
# The Flutter version matches the one the production build uses (see vercel.json).
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl unzip xz-utils zip libglu1-mesa ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pin the same Flutter version the site is built with.
RUN git clone https://github.com/flutter/flutter.git --depth 1 -b 3.47.1 /flutter
ENV PATH="/flutter/bin:/flutter/bin/cache/dart-sdk/bin:${PATH}"

# Warm the tool + web engine so first run is fast, and trust the mount dir.
RUN git config --global --add safe.directory /app \
    && flutter config --enable-web \
    && flutter precache --web

WORKDIR /app
EXPOSE 3000

# web-server device (no Chrome needed inside the container); reachable from the
# host on http://localhost:3000. Press r / R in the attached terminal to
# hot-reload / restart.
CMD ["flutter", "run", "-d", "web-server", \
     "--web-hostname", "0.0.0.0", "--web-port", "3000"]
