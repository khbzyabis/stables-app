# --- Core ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (dashboards, web preview).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (self-hosted Supabase / Postgres) ---
# The API connects as a least-privilege application role (not the superuser).
DATABASE_URL=postgresql://app:CHANGE_ME@localhost:5432/mystables?schema=public
# Pooled connection (Supavisor/PgBouncer, transaction mode) for the app tier.
DATABASE_POOL_URL=postgresql://app:CHANGE_ME@localhost:6543/mystables?schema=public

# --- Redis (rate limiting + cache) ---
REDIS_URL=redis://localhost:6379

# --- Auth (Supabase GoTrue) ---
# Used to verify JWTs issued by Supabase Auth.
SUPABASE_JWT_SECRET=CHANGE_ME
SUPABASE_URL=http://localhost:8000

# --- Rate limits (requests / window) ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_TTL_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Push notifications ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
