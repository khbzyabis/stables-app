{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "git clone https://github.com/flutter/flutter.git --depth 1 -b 3.47.1 _flutter && _flutter/bin/flutter --version",
  "buildCommand": "_flutter/bin/flutter config --enable-web && _flutter/bin/flutter build web --release --pwa-strategy=none && rm -f build/web/flutter_service_worker.js",
  "outputDirectory": "build/web",
  "rewrites": [
    { "source": "/", "destination": "/home.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
