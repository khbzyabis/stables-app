# Self-hosted Supabase configuration.
# Copy to `.env` and replace every CHANGE_ME. Generate strong secrets:
#   openssl rand -base64 48   (for POSTGRES_PASSWORD, secrets)
#   The JWT_SECRET must be >= 32 chars; ANON_KEY / SERVICE_ROLE_KEY are JWTs
#   signed with it — mint them at https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# NEVER commit the filled-in .env.

############ Secrets ############
POSTGRES_PASSWORD=CHANGE_ME_db_password
JWT_SECRET=CHANGE_ME_at_least_32_chars_long_secret
# JWTs signed with JWT_SECRET (role: anon / service_role):
ANON_KEY=CHANGE_ME_anon_jwt
SERVICE_ROLE_KEY=CHANGE_ME_service_role_jwt
# Supabase Studio (dashboard) basic-auth:
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE_ME_dashboard_password
# Secret used by the Storage service:
SECRET_KEY_BASE=CHANGE_ME_random_64_chars
VAULT_ENC_KEY=CHANGE_ME_random_32_chars

############ Database ############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############ API / URLs ############
# Public URL the apps call (behind your Hetzner LB in prod, e.g. https://api.mystables.ae)
SITE_URL=http://localhost:8080
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
# Kong gateway ports:
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3001

############ Auth (GoTrue) ############
# Email/password + Apple + Google + invite codes (configure providers in Studio).
DISABLE_SIGNUP=false
JWT_EXPIRY=3600
MAILER_AUTOCONFIRM=true          # dev only; use real SMTP in prod
# SMTP for verification/notification emails (prod):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=My Stables
SMTP_ADMIN_EMAIL=admin@mystables.ae
